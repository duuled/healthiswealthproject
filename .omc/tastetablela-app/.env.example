# ─── Taste Table LA — Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Email / Newsletter ─────────────────────────────────────────────────────
# Used by /api/subscribe to add emails to your list.
# Supported: Mailchimp, ConvertKit, Loops, etc.
NEWSLETTER_API_KEY=your_newsletter_api_key_here
NEWSLETTER_LIST_ID=your_list_id_here
NEWSLETTER_PROVIDER=mailchimp  # mailchimp | convertkit | loops

# ── Notion (spot submission logging) ──────────────────────────────────────
# Used by /api/submit-spot to log new community spot submissions.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_SUBMISSIONS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Airtable (alternative to Notion) ──────────────────────────────────────
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Spot Submissions

# ── Analytics ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tastetablela.vercel.app

# ── Site URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tastetablela.vercel.app
