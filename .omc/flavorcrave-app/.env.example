# ─── The Flavor Crave — Environment Variables ────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.

# Google AdSense Publisher ID
# Get this from: https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_ID=ca-pub-YOUR_ID

# Klaviyo API Key (for email list management)
# Get this from: https://www.klaviyo.com/account#api-keys-tab
KLAVIYO_API_KEY=your_key_here

# Optional: Mailchimp API Key + Audience ID (alternative to Klaviyo)
# MAILCHIMP_API_KEY=your_key_here
# MAILCHIMP_AUDIENCE_ID=your_audience_id

# Site URL (used for og:image absolute URLs in production)
NEXT_PUBLIC_SITE_URL=https://theflavorcrave.com
